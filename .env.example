# ═══════════════════════════════════════════════════════════════════
# MenuScan Platform — Production Environment Configuration Template
# Copy this file to .env and configure your production values
# ═══════════════════════════════════════════════════════════════════

# Server & Network Configuration
PORT=8000
HOST=0.0.0.0
NODE_ENV=production
APP_URL=https://menu.example.com

# Authentication & Security
# Generate a cryptographically secure random string for JWT signing:
JWT_SECRET=your_production_secure_jwt_secret_key_change_me_in_production

# Database Configuration
# Relative or absolute file path to SQLite database or PostgreSQL connection URL
DATABASE_PATH=data/menuscan.db
# DATABASE_URL=postgresql://user:password@localhost:5432/menuscan_prod

# File & Image Storage Configuration
STORAGE_TYPE=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Rate Limiting & Performance
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
